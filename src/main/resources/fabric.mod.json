{
	"schemaVersion": 1,
	"id": "played",
	"version": "${version}",
	"name": "Played",
	"description": "Tracks local playtime for singleplayer worlds and multiplayer servers, shows total playtime, and adds an optional Mod Menu config screen.",
	"authors": [
		"Tenkayro"
	],
	"contact": {
		"homepage": "https://tenkayro.de",
		"sources": "https://github.com/Tenkayro/Played",
		"issues": "https://github.com/Tenkayro/Played/issues"
	},
	"custom": {
		"modmenu": {
			"update_checker": true,
			"links": {
				"modmenu.modrinth": "https://modrinth.com/mod/played",
				"modmenu.discord": "https://tenkayro.de/discord"
			}
		}
	},
	"license": "LicenseRef-Played-Source-Available-1.0",
	"icon": "assets/played/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"de.tenkayro.Played"
		],
		"client": [
			"de.tenkayro.client.PlayedClient"
		],
		"modmenu": [
			"de.tenkayro.client.config.PlayedModMenu"
		]
	},
	"mixins": [
		{
			"config": "played.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"yet_another_config_lib_v3": ">=3.9.7"
	},
	"suggests": {
		"modmenu": "*"
	}
}
