{
	"schemaVersion": 1,
	"id": "played",
	"version": "26.7.0",
	"name": "Played",
	"description": "Tracks local playtime for singleplayer worlds and multiplayer servers, shows total playtime, and adds an optional Mod Menu config screen.",
	"authors": ["Zorblock"],
	"contact": {
		"homepage": "https://zorblock.de",
		"sources": "https://github.com/Zorblock/Played",
		"issues": "https://github.com/Zorblock/Played/issues"
	},
	"custom": {
		"modmenu": {
			"update_checker": true,
			"links": {
				"modmenu.modrinth": "https://modrinth.com/mod/played",
				"modmenu.discord": "https://zorblock.de/discord"
			}
		}
	},
	"license": "LicenseRef-Played-Source-Available-1.0",
	"icon": "assets/played/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": ["de.zorblock.Played"],
		"client": ["de.zorblock.client.PlayedClient"],
		"modmenu": ["de.zorblock.client.config.PlayedModMenu"]
	},
	"mixins": [
		{
			"config": "played.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"cloth-config": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"jars": [
		{"file": "META-INF/jars/adventure-api-4.17.0.jar"},
		{"file": "META-INF/jars/adventure-key-4.17.0.jar"},
		{"file": "META-INF/jars/adventure-text-minimessage-4.17.0.jar"},
		{"file": "META-INF/jars/adventure-text-serializer-gson-4.17.0.jar"},
		{"file": "META-INF/jars/adventure-text-serializer-json-4.17.0.jar"},
		{"file": "META-INF/jars/examination-api-1.3.0.jar"},
		{"file": "META-INF/jars/examination-string-1.3.0.jar"},
		{"file": "META-INF/jars/option-1.0.0.jar"}
	]
}
