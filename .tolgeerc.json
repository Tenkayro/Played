{
  "$schema": "https://docs.tolgee.io/cli-schema.json",
  "projectId": 36408,
  "format": "JSON_TOLGEE",
  "push": {
    "files": [
      {
        "path": "./src/main/resources/assets/played/lang/en_us.json",
        "language": "en_us"
      }
    ],
    "convertPlaceholdersToIcu": false,
    "forceMode": "OVERRIDE",
    "removeOtherKeys": false
  },
  "pull": {
    "path": "./build/tolgee",
    "delimiter": "",
    "supportArrays": false,
    "states": ["TRANSLATED", "REVIEWED"],
    "fileStructureTemplate": "{languageTag}.json",
    "emptyDir": false
  }
}
