{
  "name": "played-release-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive release tooling for Played",
  "scripts": {
    "build": "gradlew.bat clean build",
    "client": "gradlew.bat runClient",
    "server": "gradlew.bat runServer",
    "test": "gradlew.bat test",
    "clean": "gradlew.bat clean",
    "tasks": "gradlew.bat tasks --all",
    "sources": "gradlew.bat genSources",
    "release": "node scripts/release.mjs",
    "translations:login": "node scripts/translations.mjs login",
    "translations:push": "node scripts/translations.mjs push",
    "translations:pull": "node scripts/translations.mjs pull",
    "translations:test": "node --test scripts/translations.test.mjs",
    "translations:prepare-languages": "node scripts/prepare-languages.mjs",
    "translations:push-languages": "node scripts/translations.mjs push-languages"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0"
  },
  "devDependencies": {
    "@tolgee/cli": "2.21.0"
  }
}
